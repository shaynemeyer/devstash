# Neon PostgreSQL - pooled connection (used by Prisma Client at runtime)
DATABASE_URL=<YOUR_CONNECTION_STRING>

# Neon PostgreSQL - direct connection (used by Prisma CLI for migrations)
DIRECT_URL=<YOUR_CONNECTION_STRING>

AUTH_URL="http://localhost:3000"
AUTH_SECRET="<AUTH_SECRET>"
AUTH_GITHUB_ID="<GITHUB_ID>"
AUTH_GITHUB_SECRET="<GITHUB_SECRET>"

RESEND_API_KEY="<YOUR_RESEND_API_KEY>"

EMAIL_VERIFICATION_ENABLED=true|false

UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx...

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""

# Stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
